Q6 – Vehicle Records (HashSet)
import java.util.*;

class Vehicle {
    String reg, name, type;

    Vehicle(String r, String n, String t) {
        reg = r; name = n; type = t;
    }

    public String toString() {
        return reg + " " + name + " " + type;
    }

    public int hashCode() {
        return reg.hashCode();
    }

    public boolean equals(Object o) {
        Vehicle v = (Vehicle)o;
        return reg.equals(v.reg);
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();

        HashSet<Vehicle> set = new HashSet<>();

        for(int i = 0; i < n; i++) {
            String r = sc.next();
            String name = sc.next();
            String type = sc.next();
            set.add(new Vehicle(r, name, type));
        }

        for(Vehicle v : set)
            System.out.println(v);
    }
}
